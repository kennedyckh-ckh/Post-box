# Copy these names into your host's environment settings (Render: Environment tab).
# This file holds placeholders only. NEVER put real keys or passwords in this file, in GitHub, or in any browser.

# --- Where data lives (required on a real host) ---------------------------------
# Folder that holds app.db and uploads/. On Render, the mount path of the persistent disk.
DATA_DIR=/var/data

# --- Safe behind a host's HTTPS proxy (set both on Render) -----------------------
COOKIE_SECURE=1
TRUST_PROXY=1
# Only if sign-in says "Cross-site request blocked": your public host name, e.g. groupwork.example.org
# PUBLIC_HOST=

# --- First administrator (created once, only when there are no accounts) --------
# Sign in with these, choose a new password when asked, then DELETE these three settings.
BOOTSTRAP_ADMIN_EMAIL=you@example.org
BOOTSTRAP_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_PASSWORD=choose-a-long-temporary-password

# --- AI (optional; the platform works fully without it) -------------------------
# simulated = built-in demo, nothing leaves the server (default). hku = the HKU AI service.
AI_PROVIDER=simulated
# Only for AI_PROVIDER=hku. Enter the real values privately in Render, never here.
HKU_API_KEY=
# The COMPLETE request URL exactly as the HKU developer portal shows it (deployment path and ?api-version=... included if the portal's URL has it).
HKU_API_ENDPOINT=
# Optional. Added as ?api-version=... only if set AND the endpoint does not already contain api-version.
HKU_API_VERSION=
AI_MODEL=gpt-4.1-nano
# Set to 1 only if the gateway needs {"model": ...} inside the request body (Azure deployment URLs normally do not).
# AI_SEND_MODEL=1

# Limits for each facilitator (an administrator can change them inside the app; the app's value then wins).
AI_LIMIT_REQUESTS_PER_DAY=100
AI_LIMIT_TOKENS_PER_MONTH=500000
# Largest amount of participant text sent in one request. Longer selections are refused, never cut.
AI_MAX_INPUT_CHARS=60000
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
